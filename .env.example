# Crypto Radar — Environment Variables
# Copy to .env and fill in real values.

# ==== Core ====
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/radar.db
TIMEZONE=Asia/Jakarta

# ==== Telegram ====
# Create a bot via @BotFather
TELEGRAM_BOT_TOKEN=
# Your personal chat ID (use @userinfobot or hit /start on the bot first)
TELEGRAM_ADMIN_CHAT_ID=

# ==== Sprint 1: Derivatives ====
# All public APIs by default (no key required). Optional auth keys below.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# ==== Sprint 2: Narrative ====
COINGECKO_API_KEY=
LUNARCRUSH_API_KEY=
GITHUB_TOKEN=
NEYNAR_API_KEY=

# ==== Scheduler intervals (minutes) ====
DERIVATIVES_POLL_INTERVAL_MIN=15
NARRATIVE_POLL_INTERVAL_MIN=60
DIGEST_HOUR_LOCAL=7

# ==== Universe override (comma-separated, optional) ====
# Defaults to a hard-coded top-30 USDT-perpetual list. Override e.g.:
# DERIVATIVES_UNIVERSE=BTC,ETH,SOL,DOGE,WIF
DERIVATIVES_UNIVERSE=

# ==== Liquidation streams (Sprint 1.5+) ====
# Two public WebSockets feed the same in-memory aggregator. Both are no-auth.
# Bybit (Sprint 1.7) is the primary source because Binance's forceOrder stream
# has been observed silent from many regions despite REST being reachable;
# Binance stays a best-effort secondary. Override these only if you need to
# point at a proxy or a different region. Empty = use the public defaults.
# Honoured by both the live bot (`poetry run radar`) and the threshold tuner
# (`poetry run radar-tune`).
BINANCE_FORCEORDER_WS_URL=
BYBIT_LIQUIDATION_WS_URL=
